# CITED Part B — copy to .env and fill in. Never commit .env.
VOYGR_API_KEY=          # Callwright — https://api.voygr.tech (X-API-Key)
CRUSTDATA_API_KEY=      # CrustData — https://api.crustdata.com (Authorization: Token ...)
ANTHROPIC_API_KEY=      # content + metadata generation
GITHUB_TOKEN=           # optional — live PR creation; falls back to rendered diff
INDEXNOW_KEY=           # optional — accelerates Bing/ChatGPT discovery
DEMO_PHONE=             # a number you are authorized to call for demos, e.g. +1XXXXXXXXXX
